/**
 * @fileOverview Firestore Security Rules for RR Realty Hub.
 *
 * Core Philosophy:
 * This ruleset implements a role-based access control model. Access is determined by the `role` field in a user's profile document in the `/users/{userId}` collection.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, including their role ('master-admin', 'admin', 'user').
 * - /properties/{propertyId}: Stores property data.
 * - /inquiries/{inquiryId}: Stores user inquiries.
 * - /blog_posts/{blogPostId}: Stores blog posts.
 * - /page_content/{pageContentId}: Stores page content.
 * - /subscribers/{subscriberId}: Stores newsletter subscribers.
 * - /testimonials/{testimonialId}: Stores client testimonials.
 *
 * Key Security Decisions:
 * - Public read access for 'properties', 'blog_posts', 'page_content', 'testimonials'.
 * - Write access to most collections is restricted to users with 'admin' or 'master-admin' roles.
 * - Only 'master-admin' can manage the '/users' collection (i.e., assign roles).
 * - Data validation is minimal, focusing on authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Gets the user's role from their profile document.
     * @returns {string} The user's role, or an empty string if not found.
     */
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    /**
     * @description Checks if the user is an admin or master admin.
     */
    function isAdmin() {
      let userRole = getUserRole();
      return isSignedIn() && (userRole == 'admin' || userRole == 'master-admin');
    }

    /**
     * @description Checks if the user is a master admin.
     */
    function isMasterAdmin() {
      return isSignedIn() && getUserRole() == 'master-admin';
    }

    /**
     * @description Checks if the user is the owner of the resource.
     */
    function isOwner(userId) {
        return request.auth.uid == userId;
    }

    /**
     * @description Rules for the /users/{userId} collection.
     * @path /users/{userId}
     * @allow (read, list, write): Only master admins can manage users and roles.
     */
    match /users/{userId} {
      allow read, list, create, update, delete: if isMasterAdmin();
    }

    /**
     * @description Rules for the /properties/{propertyId} collection.
     */
    match /properties/{propertyId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Rules for the /inquiries/{inquiryId} collection.
     */
    match /inquiries/{inquiryId} {
      allow get, list: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    /**
     * @description Rules for the /blog_posts/{blogPostId} collection.
     */
    match /blog_posts/{blogPostId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Rules for the /page_content/{pageContentId} collection.
     */
    match /page_content/{pageContentId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
    
    /**
     * @description Rules for the /subscribers/{subscriberId} collection.
     */
    match /subscribers/{subscriberId} {
      allow create: if true;
      allow read, list, update, delete: if isAdmin();
    }

    /**
     * @description Rules for the /testimonials/{testimonialId} collection.
     */
    match /testimonials/{testimonialId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}

    